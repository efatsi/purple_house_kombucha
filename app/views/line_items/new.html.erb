<%= turbo_frame_tag "modal_frame" do %>
  <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-semibold">Add <%= @flavor.name %> to Order</h3>
      <button data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <%= form_with url: line_items_path, method: :post do |form| %>
      <%= form.hidden_field :flavor_id, value: @flavor.id %>
      
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Bottle Size</label>
        <%= form.select :bottle_size, options_for_select([
          ['Small', 'small'],
          ['Medium', 'medium'],
          ['Large', 'large']
        ], 'medium'), {}, { class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
      </div>
      
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
        <%= form.number_field :count, value: 1, min: 1, max: 10, class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      
      <div class="flex gap-3">
        <button type="button" data-action="click->modal#close" class="flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-400 transition-colors">
          Cancel
        </button>
        <%= form.submit "Add to Order", class: "flex-1 bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors" %>
      </div>
    <% end %>
  </div>
<% end %>