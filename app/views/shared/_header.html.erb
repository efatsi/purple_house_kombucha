<header class="bg-white shadow-sm">
  <div class="container mx-auto px-5 py-4 flex justify-between items-center">
    <%= link_to root_path, class: "text-2xl font-bold text-purple-600" do %>
      PH Kombucha
    <% end %>

    <% if current_order && current_order.line_items.any? %>
      <%= link_to checkout_path, class: "relative inline-flex items-center p-2 text-gray-700 hover:text-purple-600" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5H15m0 0a1 1 0 102 0 1 1 0 00-2 0zm-8 0a1 1 0 102 0 1 1 0 00-2 0z"/>
        </svg>
        <span class="absolute -top-2 -right-2 bg-purple-600 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">
          <%= current_order.line_items.sum(:count) %>
        </span>
      <% end %>
    <% else %>
      <div class="relative inline-flex items-center p-2 text-gray-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5H15m0 0a1 1 0 102 0 1 1 0 00-2 0zm-8 0a1 1 0 102 0 1 1 0 00-2 0z"/>
        </svg>
      </div>
    <% end %>
  </div>
</header>
